# ==========================================
# [개인정보 및 학생 데이터 보호를 위한 gitignore]
# ==========================================

# 1. 학생 개인정보 및 성적표 엑셀 파일 (깃허브 업로드 절대 금지)
*.xlsx
*.xls
*.bak

# 2. 학생 제출 과제 폴더 (학생들의 코드 및 개인정보 보호)
submissions/
10_28과제/
10_19과제/

# 3. 테스트 환경 및 임시 파일
test_env/
!requirements.txt

# 4. 파이썬 가상환경 및 캐시 파일
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
